# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://kaspi_user:kaspi_pass@localhost:5432/kaspi_subs

# ─── Service ────────────────────────────────────────────────────────────────
# Master key for admin endpoints (create projects)
ADMIN_API_KEY=change-me-admin-secret

# ─── Kaspi Pay ──────────────────────────────────────────────────────────────
# Base URL for Kaspi Pay API (fill in when you have credentials)
KASPI_BASE_URL=https://kaspi.kz/online/api
# Kaspi merchant credentials
KASPI_MERCHANT_ID=your-merchant-id
KASPI_API_TOKEN=your-api-token
# Secret Kaspi uses to sign incoming webhooks (sha256 hmac)
KASPI_WEBHOOK_SECRET=kaspi-incoming-webhook-secret

# ─── Billing Scheduler ──────────────────────────────────────────────────────
# Days before period end to generate renewal invoice
BILLING_DAYS_BEFORE_RENEWAL=3
# Grace period in days after period end before suspending
GRACE_PERIOD_DAYS=3
# Interval in seconds for invoice status polling fallback
POLL_INTERVAL_SECONDS=300

# ─── Outgoing Webhooks ──────────────────────────────────────────────────────
# Timeout for outgoing webhook POST requests (seconds)
WEBHOOK_TIMEOUT_SECONDS=10
# Max retry attempts for outgoing webhooks
WEBHOOK_MAX_RETRIES=5
