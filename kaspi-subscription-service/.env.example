# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://kaspi_user:kaspi_pass@localhost:5432/kaspi_subs

# ─── Service ────────────────────────────────────────────────────────────────
# Master key for admin endpoints (create projects, confirm payments, bot notify)
ADMIN_API_KEY=change-me-admin-secret

# ─── Способ приёма оплаты ─────────────────────────────────────────────────────
# unique_amount — кассир/бот Kaspi: ссылка + уникальная сумма (детект по сумме)
# aggregator    — сторонний REST API (apipay.kz и т.п.) с webhook
# manual        — клиент переводит и указывает код, admin подтверждает
PAYMENT_PROVIDER=unique_amount

# Реквизиты получателя (показываются клиенту в инструкции/комментарии)
KASPI_RECEIVER_PHONE=+77001234567
KASPI_RECEIVER_NAME=Имя Фамилия

# ─── unique_amount ────────────────────────────────────────────────────────────
# Статическая ссылка кассира Kaspi (Kaspi Бизнес → Удалённая → Ссылка на оплату)
KASPI_PAYMENT_LINK=https://pay.kaspi.kz/pay/XXXXXXXX
# Максимальная надбавка к базовой сумме для уникальности (тенге)
UNIQUE_AMOUNT_MAX_OFFSET=300

# ─── aggregator (опционально) ────────────────────────────────────────────────
AGGREGATOR_BASE_URL=
AGGREGATOR_API_KEY=
# Секрет, которым агрегатор подписывает входящие webhook (HMAC-SHA256)
KASPI_WEBHOOK_SECRET=

# Срок жизни выставленного счёта (часов)
INVOICE_TTL_HOURS=48

# ─── Billing Scheduler ──────────────────────────────────────────────────────
# За сколько дней до конца периода выставлять счёт на продление
BILLING_DAYS_BEFORE_RENEWAL=3
# Grace-период (дней) после конца периода до перевода в suspended
GRACE_PERIOD_DAYS=3
# Интервал джобы простановки expired (сек)
POLL_INTERVAL_SECONDS=300

# ─── Outgoing Webhooks (в ваши проекты) ──────────────────────────────────────
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=5
