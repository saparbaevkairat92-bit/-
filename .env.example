TOKEN_SECRET_KEY=
PORT=3000

# ─── Security (recommended in production) ───
# Comma-separated keys; clients send X-Api-Key or Authorization: Bearer <key>
# API_KEY=
# RATE_LIMIT_PER_MIN=300
# AUTH_RATE_LIMIT_PER_MIN=10
# TRUST_PROXY=1
# CORS_ORIGINS=https://pos.example.kz

# ─── Payments ───
# MAX_PAYMENT_AMOUNT=10000000
# POS_LATITUDE=43.2046
# POS_LONGITUDE=76.8919
# WEBHOOK_MAX_ATTEMPTS=3

# ─── Reports ───
# LEDGER_FILE=payments-ledger.jsonl
# REPORT_TZ=Asia/Almaty

# ─── App version & device constants (optional) ───
# Defaults match a known-good Kaspi Pay client.
# ⚠️ The Kaspi API validates these — use values from a real device cookie.
# APP_VERSION=4.112.1
# APP_BUILD=1107
# APP_PLATFORM=iOS
# APP_PLATFORM_VER=18.4
# APP_LOCALE=ru-RU
# APP_MODEL=iPhone16,2
# APP_BRAND=Apple
# APP_DEVICE_NAME=iPhone
# APP_SCREEN_W=430.0
# APP_SCREEN_H=932.0
# APP_CFNETWORK=CFNetwork/3826.400.120
# APP_DARWIN=Darwin/24.4.0
