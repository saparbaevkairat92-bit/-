TOKEN_SECRET_KEY=
PORT=3000

# ─── App version & device constants (optional) ───
# Defaults match a known-good Kaspi Pay client.
# ⚠️ The Kaspi API validates these — use values from a real device cookie.
# APP_VERSION=4.112.1
# APP_BUILD=1107
# APP_PLATFORM=iOS
# APP_PLATFORM_VER=18.4
# APP_LOCALE=ru-RU
# APP_MODEL=iPhone16,2
# APP_BRAND=Apple
# APP_DEVICE_NAME=iPhone
# APP_SCREEN_W=430.0
# APP_SCREEN_H=932.0
# APP_CFNETWORK=CFNetwork/3826.400.120
# APP_DARWIN=Darwin/24.4.0

# ─── Kaspi Маркетплейс (optional) ───
# Internal merchant-cabinet URLs; override only if Kaspi moves them.
# KASPI_MC_LOGIN_URL=https://idmc.shop.kaspi.kz/api/p/login
# KASPI_MC_URL=https://mc.shop.kaspi.kz
# KASPI_CITY_ID=750000000
# Сколько ждать ответа Kaspi, мс (по умолчанию 25000)
# KASPI_TIMEOUT_MS=25000
# Витрина Kaspi (место и цены конкурентов) не пускает облачные адреса —
# Railway и т.п. получают 429. Прокси с обычного IP решает это:
# KASPI_PROXY_URL=http://login:password@host:port
# KASPI_PROXY_SCOPE=storefront   # storefront — только витрина; all — все запросы к kaspi.kz

# ─── Сообщения покупателю (авто-SMS), optional ───
# Как часто фоново опрашивать заказы и слать SMS (сек, минимум 60).
# CUSTOMER_SMS_INTERVAL_SEC=180

# ─── Авто-демпинг (репрайсер), optional ───
# Интервал проверки задаётся в интерфейсе: Маркетплейс → Настройки → Демпинг.
